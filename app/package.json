{
  "name": "@padel-liga/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:read": "node scripts/db-read.mjs",
    "logs:read": "tsx scripts/logs-read.ts",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "db:seed:season:local": "tsx scripts/seed-season-local.ts",
    "test": "vitest run",
    "auth:invite": "node scripts/invite.mjs",
    "auth:superadmin": "node scripts/superadmin.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:shots": "tsx e2e/shots.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@padel-liga/rules": "*",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "isbot": "^5.1.36",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.156.1"
  }
}
