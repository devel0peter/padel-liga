/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "padel-liga",
	"compatibility_date": "2026-09-26",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Only padelparbaj.hu serves the app; www redirects via a zone Redirect Rule.
	"workers_dev": false,
	"routes": [{ "pattern": "padelparbaj.hu", "custom_domain": true }],
	// Cloudflare Access protecting /admin (see app/lib/access.server.ts).
	// Access app "Padelpárbaj admin" (padelparbaj.hu/admin, allows admin@padelparbaj.hu
	// via one-time PIN). The admin returns 403 if either value is empty.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "padelparbaj.cloudflareaccess.com",
		"ACCESS_AUD": "98cc1f4493e4533dcf39fb86ce590ff324474125db12c72b98c642d075957793",
		// Resend plan's daily quota (free: 100). Raise it after upgrading.
		"EMAIL_DAILY_LIMIT": "100",
		// Cloudflare Web Analytics site token (public, it ships in the page).
		// Site "padelparbaj.hu", manual JS snippet. Empty: no beacon.
		"CF_WEB_ANALYTICS_TOKEN": "e54368f7d73948ffb95eed22d5ee9a9d",
		// Google login (app/lib/auth/google.server.ts). The client ID is public;
		// the secret is GOOGLE_CLIENT_SECRET. Empty: the Google button is hidden.
		"GOOGLE_CLIENT_ID": ""
	},
	// Set with `npx wrangler secret put <NAME>`; locally in .dev.vars.
	// RESEND_API_KEY: sending-only key. EMAIL_SECRET: signs unsubscribe links.
	"secrets": { "required": ["RESEND_API_KEY", "EMAIL_SECRET", "GOOGLE_CLIENT_SECRET"] },
	// Hourly: sends queued emails (retries, broadcasts spread over the daily quota).
	"triggers": { "crons": ["0 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "padel-liga",
			"database_id": "ab926c11-5f24-483d-a8d3-c21ff40bb41e",
			"migrations_dir": "drizzle"
		}
	]
}
