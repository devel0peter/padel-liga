/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "padel-liga",
	"compatibility_date": "2026-09-26",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Only padelparbaj.hu serves the app; www redirects via a zone Redirect Rule.
	"workers_dev": false,
	"routes": [{ "pattern": "padelparbaj.hu", "custom_domain": true }],
	// Cloudflare Access protecting /admin (see app/lib/access.server.ts).
	// Team domain like "<team>.cloudflareaccess.com"; AUD tag of the Access app.
	// The admin returns 403 until both are set.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "padel-liga",
			"database_id": "ab926c11-5f24-483d-a8d3-c21ff40bb41e",
			"migrations_dir": "drizzle"
		}
	]
}
