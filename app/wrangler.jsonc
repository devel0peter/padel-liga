/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "padel-liga",
	"compatibility_date": "2026-09-26",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Only padelparbaj.hu serves the app; www redirects via a zone Redirect Rule.
	"workers_dev": false,
	// Smart Placement may run the Worker near the D1 database once there is
	// enough traffic to measure (a page behind login makes several database
	// round trips). With the database in Prague, the default edge is close too.
	"placement": { "mode": "smart" },
	"routes": [{ "pattern": "padelparbaj.hu", "custom_domain": true }],
	"vars": {
		// Resend plan's daily quota (free: 100). Raise it after upgrading.
		"EMAIL_DAILY_LIMIT": "100",
		// Cloudflare Web Analytics site token (public, it ships in the page).
		// Site "padelparbaj.hu", manual JS snippet. Empty: no beacon.
		"CF_WEB_ANALYTICS_TOKEN": "e54368f7d73948ffb95eed22d5ee9a9d",
		// Google login (app/lib/auth/google.server.ts). The client ID is public;
		// the secret is GOOGLE_CLIENT_SECRET. Empty: the Google button is hidden.
		"GOOGLE_CLIENT_ID": "737552847959-utt48hgu170mu5sar464f0vln28gqkpq.apps.googleusercontent.com",
		// Web push (app/lib/push/). Public; the private half is the secret
		// VAPID_PRIVATE_KEY. New pair: `node scripts/vapid-keys.mjs`.
		"VAPID_PUBLIC_KEY": "BLYFXoQxCtq5TK3RAdMbbZiMM4jEtimuNLftFY8hRIclv9qnlmOn2FoYp3Q1HW1h8XHH6sBrPMGZusBBaYDnTnw",
		// Turnstile bot check on the signup form (app/lib/turnstile.server.ts).
		// Managed widget for padelparbaj.hu. The site key is public; the
		// secret is TURNSTILE_SECRET. Empty site key: no widget and no check.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFQr1fGBC5e4lGsw",
		// Hostnames siteverify must report. Never localhost in production.
		"TURNSTILE_HOSTNAMES": "padelparbaj.hu"
	},
	// Set with `npx wrangler secret put <NAME>`; locally in .dev.vars.
	// RESEND_API_KEY: sending-only key. EMAIL_SECRET: signs unsubscribe links.
	// VAPID_PRIVATE_KEY: web push (app/lib/push/). TURNSTILE_SECRET: signup bot
	// check. RESEND_WEBHOOK_SECRET: signs Resend's bounce and complaint events
	// (/webhooks/resend), "whsec_..." from the Resend webhook page.
	"secrets": {
		"required": [
			"RESEND_API_KEY",
			"EMAIL_SECRET",
			"GOOGLE_CLIENT_SECRET",
			"VAPID_PRIVATE_KEY",
			"TURNSTILE_SECRET",
			"RESEND_WEBHOOK_SECRET"
		]
	},
	// Every 10 minutes (#183, D84): the steps of app/lib/hourly-job.server.ts. The
	// reminders keep their Budapest hours; the extra runs send what one run
	// could not within the Workers Free limits (queued pushes and emails).
	"triggers": { "crons": ["*/10 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			// EU jurisdiction (data stays in the EU), primary in Prague, near the
			// Hungarian players. Replaced the London database "padel-liga" on
			// 2026-10-05.
			"database_name": "padel-liga-eu",
			"database_id": "97e08846-1351-4eb3-8397-67cded56adc2",
			"migrations_dir": "drizzle"
		}
	]
}
